{
  "name": "spacedisk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpaceDisk - Analizador de espacio en disco para Windows",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:exe": "npm run icon && node scripts/build-sea.mjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:exe": "node scripts/smoke-exe.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.3",
    "express": "^5.3.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
